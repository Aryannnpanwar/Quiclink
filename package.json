{
  "name": "quiclink",
  "version": "1.0.0",
  "private": true,
  "description": "A small PostgreSQL-backed URL shortener for QuicLink.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:qr": "esbuild node_modules/qrcode/lib/browser.js --bundle --format=iife --global-name=QRCode --outfile=vendor/qrcode-browser.js",
    "check": "node --check server.js && node --check app.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3"
  }
}
