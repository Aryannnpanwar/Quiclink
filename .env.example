PORT=3000
# Origin embedded in API short links and combined short-link QR codes.
# Keep localhost for development; use the deployed HTTPS origin in production.
PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL is required for the link API and redirect endpoint.
# Production hosts must provide the Neon connection string through their
# secure environment-variable settings; never commit it here.
DATABASE_URL=postgresql://quiclink:change-me@localhost:5432/quiclink

# Set to true for providers that require TLS without certificate verification.
# Neon URLs should include ?sslmode=require; that setting is honored automatically.
DATABASE_SSL=false

# Optional per-process pool cap. Keep this modest with Neon pooled connections.
# PGPOOL_MAX=5
